@model StudentManagement.Models.Students

@{
    ViewBag.Title = "Student Details";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between mb-4">
        <h2 class="text-primary">Student Details</h2>
        <div>
            @Html.ActionLink("Edit", "Edit", new { id = Model.Id }, new { @class = "btn btn-warning btn-sm" }) |
            @Html.ActionLink("Back to List", "Index", new { @class = "btn btn-outline-secondary btn-sm" })
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <h5 class="card-title">Student Information</h5>

            <hr />

            <div class="row">
                <div class="col-md-6">
                    <h6><strong>Name:</strong> @Html.DisplayFor(model => model.Name)</h6>
                    <h6><strong>Roll Number:</strong> @Html.DisplayFor(model => model.Rollno)</h6>
                    <h6><strong>Department:</strong> @Html.DisplayFor(model => model.deptname)</h6>
                    <h6><strong>Date of Birth:</strong> @Model.DOB.ToString("dd-MM-yyyy")</h6>
                </div>
                <div class="col-md-6">
                    <h6><strong>Gender:</strong> @Html.DisplayFor(model => model.Gender)</h6>
                    <h6><strong>Address:</strong> @Html.DisplayFor(model => model.Address)</h6>
                    <h6><strong>Phone Number:</strong> @Html.DisplayFor(model => model.phone)</h6>
                </div>
            </div>
        </div>
    </div>
</div>


<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.min.js" integrity="sha384-BBtl+eGJRgqQAUMxJ7pMwbEyER4l1g+O15P+16Ep7Q9Q+zqX6gSbd85u4mG4QzX+" crossorigin="anonymous"></script>
