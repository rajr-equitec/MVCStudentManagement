@model IEnumerable<StudentManagement.Models.Students>
@{
    ViewBag.Title = "Old";
    int counter = 1;
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
}
<div class="container mt-5">
    <div class="d-flex justify-content-between mb-3">
        <h2 class="text-primary">Old Students</h2>
        <div>
            @Html.ActionLink("Back to List", "Index", new { @class = "btn btn-outline-secondary" })
        </div>
    </div>


    <table class="table table-striped table-bordered" id="deleteddata">
        <thead class="thead-dark">
            <tr>
                <th>SRNo.</th>
                <th>@Html.DisplayNameFor(model => model.Name)</th>
                <th>@Html.DisplayNameFor(model => model.Rollno)</th>
                <th>@Html.DisplayNameFor(model => model.deptname)</th>
                <th>@Html.DisplayNameFor(model => model.DOB)</th>
                <th>@Html.DisplayNameFor(model => model.Gender)</th>
                <th>@Html.DisplayNameFor(model => model.Address)</th>
                <th>@Html.DisplayNameFor(model => model.phone)</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@counter</td>
                    <td>@Html.DisplayFor(modelItem => item.Name)</td>
                    <td>@Html.DisplayFor(modelItem => item.Rollno)</td>
                    <td>@Html.DisplayFor(modelItem => item.deptname)</td>
                    <td>@(DateTime.Now.Subtract(item.DOB).Days / 365)</td>
                    <td>@Html.DisplayFor(modelItem => item.Gender)</td>
                    <td>@Html.DisplayFor(modelItem => item.Address)</td>
                    <td>@Html.DisplayFor(modelItem => item.phone)</td>
                    <td>
                        <a href="@Url.Action("RESTORE", new { id = item.Id })" class="btn btn-warning btn-sm me-2" title="Restore">
                            <i class="fas fa-undo"></i> Restore
                        </a>
                        <a href="@Url.Action("OLDDETAILS", new { id = item.Id })" class="btn btn-info btn-sm" title="View Details">
                            <i class="fas fa-eye"></i> Details
                        </a>
                    </td>
                </tr>
                counter++;
            }
        </tbody>
    </table>

  
    <div class="mt-3">
        <ul class="pagination justify-content-center">
            @if (currentPage > 1)
            {
                <li class="page-item">
                    @Html.ActionLink("Previous", "Old", new { page = currentPage - 1 }, new { @class = "page-link" })
                </li>
            }

            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    @Html.ActionLink(i.ToString(), "Old", new { page = i }, new { @class = "page-link" })
                </li>
            }

            @if (currentPage < totalPages)
            {
                <li class="page-item">
                    @Html.ActionLink("Next", "Old", new { page = currentPage + 1 }, new { @class = "page-link" })
                </li>
            }
        </ul>
    </div>


    <div class="mt-4 text-center">
        <button id="btnPrint" class="btn btn-success btn-lg me-3">Print <i class="fas fa-print"></i></button>
        <button id="btnDownloadExcel" class="btn btn-primary btn-lg">Download to Excel <i class="fas fa-download"></i></button>
    </div>
</div>


<script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/js/all.min.js"></script>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>

<script>

    $("#btnPrint").click(function () {
        var printWindow = window.open('', '', 'height=400,width=600');
        printWindow.document.write('<html><head><title>Print</title>');
        printWindow.document.write('<style>');
        printWindow.document.write('table { width: 100%; border-collapse: collapse; }');
        printWindow.document.write('th, td { border: 1px solid black; padding: 8px; text-align: left; }');
        printWindow.document.write('th { background-color: #f2f2f2; }');
        printWindow.document.write('h2 { text-align: center; }');
        printWindow.document.write('</style>');
        printWindow.document.write('</head><body>');
        printWindow.document.write('<h2>Student List</h2>');
        printWindow.document.write('<table>' + $('#deleteddata').html() + '</table>');
        printWindow.document.write('</body></html>');
        printWindow.document.close();
        printWindow.print();
    });

   
    $("#btnDownloadExcel").click(function () {
        var table = document.getElementById("deleteddata");
        var rows = table.rows;
        var csv = [];

        for (var i = 0; i < rows.length; i++) {
            var row = rows[i];
            var cols = row.cells;
            var rowData = [];

            for (var j = 0; j < cols.length; j++) {
                rowData.push(cols[j].innerText);
            }

            csv.push(rowData.join(","));
        }

        var csvFile = new Blob([csv.join("\n")], { type: 'text/csv' });
        var downloadLink = document.createElement("a");
        downloadLink.href = URL.createObjectURL(csvFile);
        downloadLink.download = "DELETED_DATA.csv";
        downloadLink.click();
    });
</script>
