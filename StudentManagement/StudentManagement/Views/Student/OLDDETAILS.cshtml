@model StudentManagement.Models.Students

@{
    ViewBag.Title = "OLD DETAILS";
}

<h2 class="text-center text-primary">Old Student Details</h2>

<p class="text-center">
    @Html.ActionLink("Back to List", "Index", new { @class = "btn btn-outline-secondary" })
</p>

<div class="container mt-5">
    <div class="card">
        <div class="card-header text-center">
            <h5 class="card-title">Student Details</h5>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Name)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Name)
                </dd>

                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Rollno)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Rollno)
                </dd>

                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.deptname)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.deptname)
                </dd>

                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.DOB)
                </dt>
                <dd class="col-sm-9">
                    @Model.DOB.ToString("dd-MM-yyyy")
                </dd>

                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Gender)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Gender)
                </dd>

                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Address)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Address)
                </dd>

                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.phone)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.phone)
                </dd>
            </dl>
        </div>
    </div>

  
    @*<div class="mt-4 text-center">
        <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-warning btn-lg me-2" title="Edit">
            <i class="fas fa-edit"></i> Edit
        </a>
        <a href="@Url.Action("Delete", new { id = Model.Id })" class="btn btn-danger btn-lg" title="Delete">
            <i class="fas fa-trash-alt"></i> Delete
        </a>
    </div>*@
</div>

<!-- Bootstrap JS and FontAwesome Icons -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/js/all.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
